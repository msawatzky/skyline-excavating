---
import { Image } from 'astro:assets';
import skylineLogo from '../assets/skyline-logo.png';
---

<header class="border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85">
	<div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
		<a href="/" class="flex items-center" aria-label="Skyline Excavating home">
			<Image src={skylineLogo} alt="Skyline Excavating logo" width={320} height={88} class="h-12 w-auto object-contain sm:h-14" />
		</a>

		<a
			href="#contact"
			class="inline-flex rounded-md bg-primary px-4 py-2 text-sm font-semibold !text-white transition hover:bg-secondary hover:!text-white visited:!text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		>
			Request a Quote
		</a>
	</div>
</header>
