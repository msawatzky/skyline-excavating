---
const galleryItems = [
	{
		src: '/images/excavation.jpg',
		alt: 'Soil movement and final cleanup activity',
		title: 'Basement Excavation',
	},
	{
		src: '/images/recent-work-1.jpg',
		alt: 'Gravel Driveway',
		title: 'Gravel Driveway',
	},
	{
		src: '/images/recent-work-2.jpg',
		alt: 'Slab Prep',
		title: 'Slab Prep',
	},
	{
		src: '/images/recent-work-3.jpg',
		alt: 'Final Grade',
		title: 'Final Grade',
	},
	{
		src: '/images/grading-1.jpg',
		alt: 'Shop Slab Prep',
		title: 'Shop Slab Prep',
	},
	{
		src: '/images/grading-2.jpg',
		alt: 'Residential Grading',
		title: 'Residential Grading',
	}
];
---

<section id="recent-work" class="bg-canvas py-16 sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary">Recent Work</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Real projects. Clean execution. Reliable results.</h2>
			<p class="mt-4 text-base text-slate-600">
				A look at the kind of excavation, grading, demolition, and site preparation work Skyline Excavating delivers across Central
				Alberta, from Red Deer to Edmonton.
			</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				galleryItems.map((item) => (
					<figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
						<img src={item.src} alt={item.alt} class="h-52 w-full object-cover" loading="lazy" />
						<figcaption class="px-4 py-3 text-sm font-semibold text-slate-700">{item.title}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
