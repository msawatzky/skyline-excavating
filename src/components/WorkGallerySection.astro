---
import { Image } from 'astro:assets';

const galleryItems = [
	{
		src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1400&q=80',
		alt: 'Excavator preparing a commercial job site',
		title: 'Site Preparation',
	},
	{
		src: 'https://images.unsplash.com/photo-1599707254554-027aeb4deacd?auto=format&fit=crop&w=1400&q=80',
		alt: 'Excavation equipment working on a foundation area',
		title: 'Foundation Digging',
	},
	{
		src: 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1400&q=80',
		alt: 'Construction demolition and debris removal in progress',
		title: 'Demolition & Hauling',
	},
	{
		src: 'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1400&q=80',
		alt: 'Freshly graded dirt lot ready for next phase',
		title: 'Grading & Finish',
	},
	{
		src: 'https://images.unsplash.com/photo-1509395176047-4a66953fd231?auto=format&fit=crop&w=1400&q=80',
		alt: 'Driveway removal and site cleanup preparation',
		title: 'Driveway Removal',
	},
	{
		src: 'https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=1400&q=80',
		alt: 'Excavator loading soil for dirt removal service',
		title: 'Dirt Removal',
	},
];
---

<section class="bg-canvas py-16 sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary">Recent Work</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Project visuals to show quality and scope.</h2>
			<p class="mt-4 text-base text-slate-600">
				Mockup gallery using placeholder photos. Swap these with real Skyline project images when available.
			</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				galleryItems.map((item) => (
					<figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
						<Image src={item.src} alt={item.alt} width={1400} height={900} class="h-52 w-full object-cover" loading="lazy" />
						<figcaption class="px-4 py-3 text-sm font-semibold text-slate-700">{item.title}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
