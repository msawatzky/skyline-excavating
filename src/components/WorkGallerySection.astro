---
const galleryItems = [
	{
		src: '/images/excavation.jpg',
		alt: 'Soil movement and final cleanup activity',
		title: 'Basement Excavation',
	},
	{
		src: '/images/recent-work-1.jpg',
		alt: 'Gravel Driveway',
		title: 'Gravel Driveway',
	},
	{
		src: '/images/recent-work-2.jpg',
		alt: 'Slab Prep',
		title: 'Slab Prep',
	},
	{
		src: '/images/recent-work-3.jpg',
		alt: 'Final Grade',
		title: 'Final Grade',
	},
	{
		src: '/images/grading-1.jpg',
		alt: 'Shop Slab Prep',
		title: 'Shop Slab Prep',
	},
	{
		src: '/images/grading-2.jpg',
		alt: 'Residential Grading',
		title: 'Residential Grading',
	}
];
---

<section id="recent-work" class="bg-slate-950 py-16 sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-400">Recent Work</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Real projects. Clean execution. Reliable results.</h2>
			<p class="mt-4 text-base text-slate-400">
				A look at the kind of excavation, grading, and site & slab preparation work Skyline Excavating delivers across Central
				Alberta.
			</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				galleryItems.map((item) => (
					<figure
						class="group cursor-pointer overflow-hidden rounded-xl border border-zinc-600 bg-white shadow-card transition duration-200 hover:border-blue-400 hover:shadow-lg"
						data-lightbox-src={item.src}
						data-lightbox-alt={item.alt}
						data-lightbox-title={item.title}
					>
						<div class="overflow-hidden">
							<img
								src={item.src}
								alt={item.alt}
								class="h-52 w-full object-cover transition duration-200 group-hover:scale-105"
								loading="lazy"
							/>
						</div>
						<figcaption class="px-4 py-3 text-sm font-semibold text-slate-700">{item.title}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<!-- Lightbox -->
<div
	id="lightbox"
	class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
	role="dialog"
	aria-modal="true"
	aria-label="Image viewer"
>
	<button
		id="lightbox-close"
		class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25"
		aria-label="Close"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
			<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
		</svg>
	</button>

	<div class="flex max-h-full max-w-5xl flex-col items-center gap-3">
		<img id="lightbox-img" src="" alt="" class="max-h-[80vh] max-w-full rounded-lg object-contain shadow-2xl" />
		<p id="lightbox-caption" class="text-sm font-semibold text-white"></p>
	</div>
</div>

<script>
	const lightbox = document.getElementById('lightbox')!;
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
	const lightboxCaption = document.getElementById('lightbox-caption')!;

	const open = (src: string, alt: string, title: string) => {
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightboxCaption.textContent = title;
		lightbox.classList.remove('hidden');
		lightbox.classList.add('flex');
		document.body.style.overflow = 'hidden';
	};

	const close = () => {
		lightbox.classList.add('hidden');
		lightbox.classList.remove('flex');
		document.body.style.overflow = '';
	};

	document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((figure) => {
		figure.addEventListener('click', () => {
			open(
				figure.dataset.lightboxSrc!,
				figure.dataset.lightboxAlt!,
				figure.dataset.lightboxTitle!,
			);
		});
	});

	document.getElementById('lightbox-close')!.addEventListener('click', close);

	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) close();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') close();
	});
</script>
