---
const galleryItems = [
	{
		src: '/images/recent-work-1.jpg',
		alt: 'Excavation site preparation in progress',
		title: 'Site Preparation',
	},
	{
		src: '/images/recent-work-2.jpg',
		alt: 'Excavation equipment working at a project site',
		title: 'Foundation Digging',
	},
	{
		src: '/images/recent-work-3.jpg',
		alt: 'Demolition and site cleanup work in progress',
		title: 'Demolition & Hauling',
	},
	{
		src: '/images/grading-1.jpg',
		alt: 'Freshly graded lot ready for the next phase',
		title: 'Grading & Finish',
	},
	{
		src: '/images/grading-2.jpg',
		alt: 'Driveway and access area preparation work',
		title: 'Driveway Removal',
	},
	{
		src: '/images/grading-3.jpg',
		alt: 'Soil movement and final cleanup activity',
		title: 'Dirt Removal',
	},
];
---

<section id="recent-work" class="bg-canvas py-16 sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-secondary">Recent Work</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Project visuals to show quality and scope.</h2>
			<p class="mt-4 text-base text-slate-600">
				Use this section to showcase excavation, grading, demolition, and haul-off projects from communities between Red Deer and
				Edmonton. Replacing the current sample imagery with real Skyline job photos will materially strengthen local SEO and trust.
			</p>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				galleryItems.map((item) => (
					<figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-card">
						<img src={item.src} alt={item.alt} class="h-52 w-full object-cover" loading="lazy" />
					</figure>
				))
			}
		</div>
	</div>
</section>
