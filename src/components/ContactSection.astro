<section id="contact" class="bg-primary py-16 sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 lg:grid-cols-12 lg:items-start">
			<div class="text-white lg:col-span-5">
				<p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-100">Request a quote</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Tell us about your project.</h2>
				<p class="mt-4 text-base leading-relaxed text-blue-100">
					Share your details, location, and service needs. You will get a direct, prompt follow-up with scope guidance and next
					steps for projects anywhere in Central Alberta.
				</p>
				<p class="mt-4 text-sm leading-relaxed text-blue-100">
					Serving Central Alberta with excavation, grading, demolition, augering, foundations, driveway removal, and haul-off.
				</p>
				<a
					href="tel:+14037045776"
					class="mt-6 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold !text-primary transition hover:bg-secondary hover:!text-white visited:!text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:hidden"
				>
					Call Now
				</a>
			</div>

			<form
				class="rounded-xl bg-white p-6 shadow-card sm:p-8 lg:col-span-7"
				method="post"
				action="https://formspree.io/f/mgodynod"
			>
				<div class="grid gap-5 sm:grid-cols-2">
					<label class="flex flex-col gap-2 text-sm font-medium text-slate-700">
						Name
						<input
							name="name"
							autocomplete="name"
							required
							class="rounded-md border border-slate-300 px-3 py-2 text-slate-900 outline-none ring-primary transition placeholder:text-slate-400 focus:border-primary focus:ring-2"
							type="text"
							placeholder="Your full name"
						/>
					</label>
					<label class="flex flex-col gap-2 text-sm font-medium text-slate-700">
						Email
						<input
							name="email"
							autocomplete="email"
							required
							class="rounded-md border border-slate-300 px-3 py-2 text-slate-900 outline-none ring-primary transition placeholder:text-slate-400 focus:border-primary focus:ring-2"
							type="email"
							placeholder="name@email.com"
						/>
					</label>
					<label class="flex flex-col gap-2 text-sm font-medium text-slate-700 sm:col-span-2">
						Service Type
						<select
							name="serviceType"
							required
							class="rounded-md border border-slate-300 px-3 py-2 text-slate-900 outline-none ring-primary transition focus:border-primary focus:ring-2"
						>
							<option value="">Choose a service</option>
							<option>Excavation</option>
							<option>Backfilling</option>
							<option>Grading</option>
							<option>Driveways</option>
							<option>Demolition</option>
							<option>Augering & Piles</option>
						</select>
					</label>
					<label class="flex flex-col gap-2 text-sm font-medium text-slate-700 sm:col-span-2">
						Message
						<textarea
							name="message"
							required
							rows="4"
							class="rounded-md border border-slate-300 px-3 py-2 text-slate-900 outline-none ring-primary transition placeholder:text-slate-400 focus:border-primary focus:ring-2"
							placeholder="Tell us about your project timeline, location, and scope."
						></textarea>
					</label>
				</div>

				<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<button
						type="submit"
						class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-base font-semibold !text-white transition hover:bg-secondary hover:!text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						Send Request
					</button>
					<a href="tel:+14037045776" class="hidden text-sm font-semibold text-primary transition hover:text-secondary sm:inline-flex">
						Call Now: 403-704-5776
					</a>
				</div>
			</form>
		</div>
	</div>
</section>
