---
const services = [
	{
		name: 'Augering',
		description: 'Precise post, pier, and footing holes drilled to the right depth and spacing for your build.',
	},
	{
		name: 'Concrete Breaking & Hauling',
		description: 'Break up and remove concrete slabs, pads, and debris with clean haul-off from the site.',
	},
	{
		name: 'Demolition',
		description: 'Controlled teardown and removal of small structures and site elements with safety-first planning.',
	},
	{
		name: 'Dirt Removal',
		description: 'Excavate and haul excess soil to keep your property clean, level, and ready for the next phase.',
	},
	{
		name: 'Driveway Removal',
		description: 'Efficient removal of failing concrete or asphalt driveways in preparation for replacement work.',
	},
	{
		name: 'Excavation & Grading',
		description: 'Accurate cut, fill, and grade work to support drainage, access, and proper site preparation.',
	},
	{
		name: 'Foundations',
		description: 'Excavation for foundation footprints and footings with careful layout and depth control.',
	},
];
---

<section id="services" class="bg-slate-950 py-16 text-white sm:py-20">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-300">Services</p>
			<h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Professional excavation solutions for every project stage.</h2>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				services.map((service) => (
					<article class="rounded-lg border border-slate-700 bg-slate-900/70 p-6 transition hover:border-secondary hover:bg-slate-900">
						<h3 class="text-xl font-semibold text-white">{service.name}</h3>
						<p class="mt-3 text-sm text-slate-300">{service.description}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
