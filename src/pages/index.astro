---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StickySectionNav from '../components/StickySectionNav.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import WorkGallerySection from '../components/WorkGallerySection.astro';
import ServiceAreaSection from '../components/ServiceAreaSection.astro';
import ContactSection from '../components/ContactSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { buildStructuredData, SITE_DESCRIPTION, SITE_NAME } from '../data/site';

const structuredData = buildStructuredData();
const pageTitle = `${SITE_NAME} | Excavation & Grading in Central Alberta`;
---

<Layout
	title={pageTitle}
	description={SITE_DESCRIPTION}
	image="/images/excavation.jpg"
	structuredData={structuredData}
>
	<Header />
	<StickySectionNav />
	<main>
		<HeroSection />
		<ServicesSection />
		<AboutSection />
		<WorkGallerySection />
		<ServiceAreaSection />
		<ContactSection />
	</main>
	<SiteFooter />
</Layout>
